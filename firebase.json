{
  "hosting": {
    "public": "public",
    "predeploy": [
      "npm run prepare:hosting-data"
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "headers": [
          {
            "value": "no-cache, no-store, must-revalidate",
            "key": "Cache-Control"
          }
        ],
        "source": "**/ai-chat.js"
      }
    ]
  }
}
